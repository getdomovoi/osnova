  "phases": {
    "scan": "directory walk and ignore rules",
    "grammarLoad": "first load of every WASM grammar the corpus needs, once per process",
    "read": "file read, SHA-256 and UTF-8 decode",
    "parse": "tree-sitter parse of the source text into a syntax tree (WASM grammar)",
    "walk": "adapter walk of the tree into definitions and raw edges, plus shadowed-declaration marking",
    "extractOther": "the rest of extractCard: symbol assembly, sorting and card construction",
    "resolve": "edge resolution across files: imports, re-exports, bindings, receivers",
    "serialize": "artifact assembly and JSON encoding in memory",
    "save": "gzip and write of the core, edges and text sections"
  },
  "reading": "parse is the WASM grammar; walk, resolve, serialize and save are TypeScript. Native grammar bindings could only shorten the parse row.",
  "outcome": {
    "question": "Does tree-sitter parsing dominate a full build, so that native grammar bindings would be worth their platform binaries and the web-tree-sitter pin?",
    "answer": "No. On six of seven corpora the adapter walk takes 1.9 to 2.7 times the parse; only the C# corpus has parse and walk within 10 percent of each other. Across all seven, parse is 17 to 39 percent of attributed build time and on those six the TypeScript phases (walk, symbol assembly, resolve, serialize, save) are 63 to 78 percent. Halving parse everywhere would cut single-thread build time by 8 to 19 percent; the same effort on the walk buys more on every corpus but one.",
    "decision": "Native tree-sitter bindings are not priced. The next build-time lever is the adapter walk, concentrated in the TypeScript and Python binding collector: on the two largest corpora it is 918 ms of 1904 ms and 1284 ms of 4046 ms.",
    "reopenIf": "A corpus whose grammar is measured at more than half of attributed build time, or a walk optimization that leaves parse as the largest remaining phase."
  },
