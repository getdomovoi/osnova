{
  "name": "@getdomovoi/osnova",
  "mcpName": "io.github.getdomovoi/osnova",
  "version": "0.8.1",
  "description": "Deterministic code map for AI coding agents: a tree-sitter symbol and call graph served over MCP and a CLI, with no embeddings, network or telemetry.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "getdomovoi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getdomovoi/osnova.git"
  },
  "bugs": {
    "url": "https://github.com/getdomovoi/osnova/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "ai-agent",
    "coding-agent",
    "code-context",
    "code-index",
    "call-graph",
    "tree-sitter",
    "static-analysis",
    "claude-code",
    "codex",
    "opencode",
    "code-graph",
    "repo-map",
    "code-intelligence",
    "cursor",
    "kilo",
    "pi"
  ],
  "homepage": "https://github.com/getdomovoi/osnova#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.4.1",
  "bin": {
    "osnova": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    },
    "./enrichment": {
      "types": "./dist/enrichment.d.ts",
      "import": "./dist/enrichment.js"
    }
  },
  "files": [
    "dist",
    "integrations",
    "README.md",
    "LICENSE",
    "PRIVACY.md",
    "SECURITY.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "perf": "pnpm build && node scripts/perf.mjs",
    "benchmark": "tsx scripts/bench/cli.ts",
    "check:package": "node scripts/check-package.mjs",
    "test:package": "pnpm build && node scripts/package-smoke.mjs",
    "test:install": "pnpm build && node scripts/clean-install-smoke.mjs",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ignore": "^7.0.9",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^9.39.5",
    "js-tiktoken": "1.0.21",
    "tsup": "^8.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.0"
  }
}
