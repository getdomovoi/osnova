{
  "name": "@getdomovoi/osnova",
  "version": "0.1.0",
  "description": "Deterministic repository context engine: tree-sitter symbol/edge graph with CLI and MCP stdio server.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "getdomovoi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getdomovoi/osnova.git"
  },
  "bugs": {
    "url": "https://github.com/getdomovoi/osnova/issues"
  },
  "keywords": [
    "tree-sitter",
    "code-index",
    "repository-context",
    "mcp",
    "static-analysis"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.4.1",
  "bin": {
    "osnova": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "perf": "node scripts/perf.mjs",
    "changeset": "changeset",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ignore": "^7.0.9",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@types/emscripten": "^1.41.6",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "tsup": "^8.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.0"
  }
}
