{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "npx -y @getdomovoi/osnova@0.12.0 hook session", "timeout": 15 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "npx -y @getdomovoi/osnova@0.12.0 hook prompt", "timeout": 15 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "npx -y @getdomovoi/osnova@0.12.0 hook stop", "timeout": 30 }] }]
  }
}
