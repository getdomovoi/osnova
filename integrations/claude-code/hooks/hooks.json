{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "npx -y @getdomovoi/osnova hook session", "timeout": 15 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "npx -y @getdomovoi/osnova hook prompt", "timeout": 15 }] }],
    "PreToolUse": [{ "matcher": "Grep|Bash", "hooks": [{ "type": "command", "command": "npx -y @getdomovoi/osnova hook search", "timeout": 10 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "npx -y @getdomovoi/osnova hook stop", "timeout": 30 }] }]
  }
}
