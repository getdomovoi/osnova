#!/bin/sh
# Pre-push gate: run lint, typecheck, and tests on what is about to be pushed.
# Skips when pushing tags or deleting a remote ref. Serves as a client-side
# backstop only; branch protection on main is the enforcing gate.

set -u

zero=$(git hash-object -t tree /dev/null)
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in
    refs/tags/*) continue ;;
  esac

  if [ "$local_sha" = "$zero" ]; then
    continue
  fi

  if ! git diff --quiet "$remote_sha" "$local_sha" -- src test scripts 2>/dev/null; then
    echo "osnova: verifying push of $local_ref before sending"
  fi
done

echo "osnova: running lint"
if ! pnpm lint; then
  echo "osnova: push blocked — lint failed (pnpm lint)" >&2
  exit 1
fi

echo "osnova: running typecheck"
if ! pnpm typecheck; then
  echo "osnova: push blocked — typecheck failed (pnpm typecheck)" >&2
  exit 1
fi

echo "osnova: running tests"
if ! pnpm test; then
  echo "osnova: push blocked — tests failed (pnpm test)" >&2
  exit 1
fi

echo "osnova: gates passed, pushing"
exit 0
